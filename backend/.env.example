# Example environment file — copy to `.env` and edit if needed:
#     copy .env.example .env        (Windows)
#     cp .env.example .env          (macOS / Linux)
#
# All 17 variables read by app/config.py appear below, so an unedited copy of
# this file is a working configuration on a machine where Ollama and Tesseract
# are installed normally. Values match config.py's own fallbacks with one
# deliberate exception: config.py still falls back to OLLAMA_MODEL=llama3.1:8b
# (the spec §6.1 model), while this file sets llama3.2:latest — the model the
# Day 9 §32 checklist was actually verified against on an 8 GB machine. See the
# OLLAMA_MODEL comment below and README "Choosing a model".
#
# There are no secrets here and there never will be: the project uses no paid
# services and no external APIs (spec §11, §17). Everything points at localhost.
#
# Relative paths are resolved from the directory you run uvicorn in, which is
# `backend/`.
#
# Every numeric variable below is range-checked when the app starts (Day 2). A
# value that is not a whole number, or is below its stated minimum, stops the
# backend immediately with a message naming the variable — rather than letting
# the backend start "healthy" and then fail during an upload or a question. The
# minimum for each one is noted with the variable.

# ── LLM (Ollama) ─────────────────────────────────────────────────────────────

# Where Ollama is listening. `ollama serve` uses this port by default.
#
# Use the literal 127.0.0.1 rather than "localhost". On Windows "localhost"
# resolves to ::1 first and Ollama binds IPv4 only, so every new connection
# waits for the IPv6 refusal before falling back — measured on the dev machine
# as 2065 ms via "localhost" against 8.3 ms via 127.0.0.1, paid on every
# question. Point this at a hostname only if Ollama runs on another machine.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Pick the model to match your RAM (measured Day 9 — see README "Choosing a model"):
#   >=16 GB RAM : llama3.1:8b      (the spec model, spec §6.1 — best answer quality)
#   ~8 GB RAM   : llama3.2:latest  (2.0 GB; the verified default on 8 GB machines)
OLLAMA_MODEL=llama3.2:latest

# How long to wait for a generation before returning 503. Generous on purpose:
# the first request after `ollama serve` starts also pays for loading the model
# into memory, which took ~4 minutes for llama3.1:8b on the dev machine. Note
# the frontend waits longer than this (api.js, 360 s) so the backend's
# actionable 503 wins the race instead of a bare client-side abort.
# Minimum 1.
OLLAMA_TIMEOUT_SECONDS=300

# ── Embeddings ───────────────────────────────────────────────────────────────

# sentence-transformers model. 384-dim, ~80 MB, CPU-only. Downloaded from
# Hugging Face on first use and cached; changing this invalidates any vectors
# already in ChromaDB, so re-upload your documents if you change it.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Vector store & file storage ──────────────────────────────────────────────

# ChromaDB's persistent directory. Created automatically at startup.
CHROMA_PERSIST_DIR=./data/chroma_db

# Where uploaded PDFs are stored, named by generated UUID (never by the
# user-supplied filename — spec §11).
UPLOAD_DIR=./data/uploads

# SQLite file holding the `documents` metadata table. Created at startup.
DATABASE_PATH=./data/pdf_chatbot.db

# Largest PDF accepted per file. Enforced by the backend, and mirrored in the
# frontend so oversized files are rejected before they are uploaded.
# Minimum 1 — at 0 every non-empty upload would be rejected as oversized.
MAX_FILE_SIZE_MB=20

# ── Chunking (spec §5.1) ─────────────────────────────────────────────────────

# Characters per chunk, and how much consecutive chunks overlap. 500/100
# balances retrieval precision against keeping enough surrounding context for
# an answer to make sense.
# CHUNK_SIZE minimum 1. CHUNK_OVERLAP minimum 0 and must be strictly SMALLER
# than CHUNK_SIZE — chunks cannot overlap by more than their own length, and the
# text splitter refuses to be built otherwise.
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# ── Retrieval & context (spec §5.2) ──────────────────────────────────────────

# How many chunks the retriever returns for a question.
# Minimum 1 — at 0 or below, retrieval returns nothing and every question is
# answered "not found" with no explanation.
TOP_K_RESULTS=5

# Ceiling on the assembled context handed to the model. Converted to a
# character budget internally (~4 chars/token); chunks arrive best-first, so
# spending the budget always drops the least relevant ones.
# Minimum 1.
MAX_CONTEXT_TOKENS=2500

# ── Frontend / CORS ──────────────────────────────────────────────────────────

# The only origin the API accepts browser requests from (spec §11).
FRONTEND_ORIGIN=http://localhost:5173

# ── OCR (Tesseract — spec §6.5, F2b) ─────────────────────────────────────────

# Master switch. Set to false to revert to v1 behaviour: pages with no embedded
# text are skipped instead of being OCR'd.
OCR_ENABLED=true

# Tesseract language pack. `eng` ships with every standard install.
OCR_LANGUAGE=eng

# Resolution used when rendering a PDF page to an image for OCR. Higher is more
# accurate and slower; 300 is the usual scanning DPI.
# Minimum 72 — that is PDF user-space DPI (a 1:1 render). Below it the renderer
# is asked for a sub-pixel image, fails inside MuPDF, and OCR silently returns
# nothing for every page.
OCR_DPI=300

# Leave EMPTY if `tesseract --version` works in your terminal — the binary is on
# PATH and will be found. Set it only if Tesseract is installed somewhere the
# PATH does not cover, which is common on Windows, e.g.:
#     TESSERACT_CMD_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
# If OCR is unavailable the app still runs: /api/health reports
# `ocr_available: false` and scanned pages are skipped rather than crashing.
TESSERACT_CMD_PATH=
